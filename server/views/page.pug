extends master.pug

block head
  if injectCode.css
    style(type='text/css')!= injectCode.css
  if injectCode.head
    != injectCode.head
  if config.features.featurePageComments && effectivePermissions.comments.read
    != comments.head

  //- Article OpenGraph overrides
  meta(property='og:type', content='article')
  if page.createdAt
    meta(property='article:published_time', content=new Date(page.createdAt).toISOString())
  if page.updatedAt
    meta(property='article:modified_time', content=new Date(page.updatedAt).toISOString())
  if page.authorName
    meta(property='article:author', content=page.authorName)
  if page.tags && page.tags.length
    each tag in page.tags
      meta(property='article:tag', content=tag.title || tag.tag)

  //- Article + BreadcrumbList JSON-LD
  - const _pageHost = (config.host || '').replace(/\/$/, '')
  - const _pageUrl = pageMeta.url
  - const _articleSchema = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', '@id': _pageUrl + '#article', name: page.title, headline: page.title, description: page.description || '', url: _pageUrl, datePublished: page.createdAt, dateModified: page.updatedAt, inLanguage: page.localeCode, author: { '@type': 'Person', name: page.authorName || 'Longevipedia' }, publisher: { '@type': 'Organization', '@id': _pageHost + '/#organization', name: config.title, url: _pageHost, logo: { '@type': 'ImageObject', url: _pageHost + (config.logoUrl || '/images/longevipedia_logo_image_transparent.png') } }, mainEntityOfPage: { '@type': 'WebPage', '@id': _pageUrl }, isPartOf: { '@id': _pageHost + '/#website' }, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', 'h2', '.wiki-content p'] } }
  - const _bcItems = breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: i === 0 ? _pageHost : _pageHost + b.path }))
  - const _bcSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: _bcItems }
  script(type='application/ld+json') !{JSON.stringify(_articleSchema)}
  script(type='application/ld+json') !{JSON.stringify(_bcSchema)}

block body
  #root
    page(
      locale=page.localeCode
      path=page.path
      title=page.title
      description=page.description
      :tags=page.tags
      created-at=page.createdAt
      updated-at=page.updatedAt
      author-name=page.authorName
      :author-id=page.authorId
      editor=page.editorKey
      :is-published=(page.isPublished ? 'true' : 'false')
      toc=Buffer.from(page.toc).toString('base64')
      :page-id=page.id
      sidebar=Buffer.from(JSON.stringify(sidebar)).toString('base64')
      nav-mode=config.nav.mode
      comments-enabled=effectivePermissions.comments.read
      :toc-enabled=(page.extra && page.extra.toc === false ? 'false' : 'true')
      :tags-enabled=(page.extra && page.extra.tags === false || config.theming.showTags === false ? 'false' : 'true')
      :history-enabled=(page.extra && page.extra.history === false ? 'false' : 'true')
      :search-enabled=(page.extra && page.extra.search === false ? 'false' : 'true')
      effective-permissions=Buffer.from(JSON.stringify(effectivePermissions)).toString('base64')
      comments-external=comments.codeTemplate
      edit-shortcuts=Buffer.from(JSON.stringify(config.editShortcuts)).toString('base64')
      initial-breadcrumbs=Buffer.from(JSON.stringify(breadcrumbs)).toString('base64')
      filename=pageFilename
      :limit-reached=(anonViewLimit && anonViewLimit.limitReached ? true : false)
      :remaining-views=(anonViewLimit && anonViewLimit.remainingViews !== undefined ? anonViewLimit.remainingViews : -1)
      :soft-prompt=(anonViewLimit && anonViewLimit.softPrompt ? true : false)
      :warn-reached=(anonViewLimit && anonViewLimit.warnReached ? true : false)
      :cta-enabled=(anonViewLimit && anonViewLimit.ctaEnabled ? true : false)
      cta-variant=(anonViewLimit && anonViewLimit.ctaVariant ? anonViewLimit.ctaVariant : '')
      :cta-frequency-hours=(config.conversionCta && config.conversionCta.frequencyHours ? config.conversionCta.frequencyHours : 24)
      :membership-max-rows=(membershipInfo && membershipInfo.maxRows !== undefined ? membershipInfo.maxRows : null)
      membership-tier-key=(membershipInfo && membershipInfo.tierKey ? membershipInfo.tierKey : 'free')
      )
      template(slot='contents')
        div!= page.render
      if effectivePermissions.comments.read
        template(slot='comments')
          div!= comments.main
  if injectCode.body
    != injectCode.body
  if config.features.featurePageComments && effectivePermissions.comments.read
    != comments.body
